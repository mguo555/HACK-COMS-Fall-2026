{
  "name": "the-daily-stalk",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "server": "tsx server/main.ts",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:server\" \"npm:start\"",
    "dev:tailnet": "node scripts/tailnet.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:watch": "tsx watch server/main.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "deploy": "scripts/deploy.sh"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "nodemailer": "^10.4.0",
    "rxjs": "~7.8.0",
    "sharp": "^0.35.5",
    "tslib": "^2.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^9.2.5",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.12"
  }
}

# Copy this file to .env, then paste your key after the = sign.
#   cp .env.example .env && chmod 600 .env
# .env is git-ignored and only read by the Node server (server/env.mjs). Never put the key in
# Angular code (src/), which ships to the browser. See docs/SECURITY.md.

# Gemini plays all four AI characters. Get a key at https://aistudio.google.com/ (Get API key)
GEMINI_API_KEY=

# Optional: model
# POKER_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: usage caps (0 = no limit). The daily count persists in .data/ across restarts.
# POKER_GEMINI_PER_MINUTE=8
# POKER_GEMINI_PER_DAY=200

# Optional: server
# PORT=3001
# HOST=127.0.0.1

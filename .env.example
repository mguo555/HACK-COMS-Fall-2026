# Copy this file to .env and fill in what you need:
#   cp .env.example .env && chmod 600 .env
# .env is git-ignored and only read by the Node server (server/env.mjs). Everything here is
# optional for local development. See docs/SECURITY.md.

# Email for sign-in codes. Use the emailer service OR SMTP. With neither, codes print to the
# server console instead, which is fine for development.
#
# The team's emailer service (sends from its Gmail account):
# EMAILER_URL=https://emailer.aceiq.ca/send-email
# EMAILER_KEY=            (optional, sent as "Authorization: Bearer ...")
#
# Or any SMTP account. For Gmail, turn on 2-step verification and use an app password
# (https://myaccount.google.com/apppasswords).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=TheDailyStalk <you@gmail.com>

# Who can use the mod queue (comma separated RIT emails).
# ADMIN_EMAILS=abc1234@rit.edu

# Where people reach the site. Turns on Secure cookies when it starts with https://.
# PUBLIC_URL=https://dailystalk.example.com

# Who can sign up. Defaults: rit.edu and g.rit.edu, with usernames like abc1234.
# Leave EMAIL_USERNAME_PATTERN= empty to accept any username at those domains.
# EMAIL_DOMAINS=rit.edu,g.rit.edu
# EMAIL_USERNAME_PATTERN=^[a-z]{2,4}[0-9]{3,4}$

# Set to false to let signed-out visitors see the photos (posting still needs an account).
# MEMBERS_ONLY=true

# Reports needed to hide a photo until a mod looks at it.
# REPORTS_TO_HIDE=3

# Largest upload, in MB.
# MAX_UPLOAD_MB=15

# When a day starts. Midnight in this time zone.
# TIME_ZONE=America/New_York

# Database. Production uses Postgres (compose.yaml sets this up). Leave it unset for development:
# the server then runs PGlite, the same Postgres running inside Node, in DATA_DIR/pglite.
# DATABASE_URL=postgres://stalk:password@localhost:5432/stalk

# Server. Keep HOST on loopback unless a reverse proxy sits in front. Behind Cloudflare (proxy or
# tunnel) or any reverse proxy, set TRUST_PROXY=true so rate limits see each visitor's address.
# PORT=3001
# HOST=127.0.0.1
# TRUST_PROXY=false
# DATA_DIR=.data
